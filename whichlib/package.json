{
  "name": "whichlib",
  "version": "0.1.0",
  "description": "The dependency picker for coding agents: an MCP server that recommends, compares and scores GitHub repositories, plus a daily dashboard of the most-starred new repos.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "dependencies",
    "github",
    "recommendation",
    "claude-code",
    "cursor",
    "developer-tools"
  ],
  "homepage": "https://github.com/josifb/whichlib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josifb/whichlib.git",
    "directory": "whichlib"
  },
  "bugs": "https://github.com/josifb/whichlib/issues",
  "mcpName": "io.github.josifb/whichlib",
  "author": "Josif Todorovski",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "mcp/*.mjs",
    "lib/",
    "snapshot/src/",
    "server.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "whichlib": "mcp/server.mjs"
  },
  "scripts": {
    "test": "node --test \"snapshot/test/**/*.test.mjs\" \"mcp/test/**/*.test.mjs\"",
    "snapshot": "node snapshot/src/run.mjs",
    "enrich": "node snapshot/src/enrich.mjs",
    "score": "node snapshot/src/score-report.mjs",
    "pull-data": "node snapshot/src/pull-data.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:smoke": "node mcp/smoke.mjs",
    "eval": "node mcp/eval/run-eval.mjs",
    "bundle": "node mcpb/build.mjs",
    "publish:smithery": "node mcpb/publish-smithery.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
